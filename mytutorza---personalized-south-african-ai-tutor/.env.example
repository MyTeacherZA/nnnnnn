# Llama 3.3 brain for Tutoring, Study and Exam agents (OpenAI-compatible).
# Groq is used by default; override with Together/Ollama/OpenRouter via LLAMA_BASE_URL.
LLAMA_API_KEY="your-llama-or-groq-api-key"
LLAMA_BASE_URL="https://api.groq.com/openai/v1"
LLAMA_MODEL="llama-3.3-70b-versatile"

# APP_URL
APP_URL="http://localhost:3000"

# Supabase
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_JWT_SECRET="your-jwt-secret"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# Upstash Redis REST
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# CAPS curriculum vault (450 PDFs) - place the DBE CAPS PDFs under this folder
CAPS_VAULT_PATH="./caps_vault"
# --- Password recovery email (SMTP) -----------------------------------------
# NOTE: your Supabase/GitHub login has nothing to do with this section.
# Gmail requires 2-Step Verification ON, then create a 16-character App
# Password at https://myaccount.google.com/apppasswords (paste without spaces).
# Test with: npm run mail:test -- you@example.com
# Or use Resend/Brevo/SendGrid instead (smtp.resend.com:465, user "resend").
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="lexiparcio@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
SMTP_FROM="MyTutorZA <lexiparcio@gmail.com>"

# --- Public URL used in password-reset links --------------------------------
APP_URL="https://mytutorza.online"

# --- PayPal subscriptions ----------------------------------------------------
# Billing enforcement switches on automatically once CLIENT_ID, CLIENT_SECRET
# and at least ONE plan id are set. Until then access stays open.
PAYPAL_MODE="sandbox"                # "live" in production
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
PAYPAL_PLAN_WEEKLY_USD="P-..."
PAYPAL_PLAN_MONTHLY_USD="P-..."
PAYPAL_PLAN_WEEKLY_GBP="P-..."
PAYPAL_PLAN_MONTHLY_GBP="P-..."
