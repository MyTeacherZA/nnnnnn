{
  "name": "mytutorza-deploy-root",
  "private": true,
  "version": "0.0.0",
  "description": "Deployment wrapper. The actual MyTutorZA app lives in ./mytutorza---personalized-south-african-ai-tutor",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "npm --prefix mytutorza---personalized-south-african-ai-tutor ci --no-audit --no-fund && npm --prefix mytutorza---personalized-south-african-ai-tutor run build",
    "build": "npm --prefix mytutorza---personalized-south-african-ai-tutor run build",
    "start": "npm --prefix mytutorza---personalized-south-african-ai-tutor start"
  }
}
